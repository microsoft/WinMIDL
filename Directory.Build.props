<Project>
  <PropertyGroup>
    <!-- Shared package and binary version; release builds can override with /p:Version. -->
    <Version Condition="'$(Version)' == ''">0.1.20</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);WITH_COMPAT</DefineConstants>
    <!-- Feature-staging support (feature_name declarations, [feature] gating). Enabled by default. -->
    <DefineConstants>$(DefineConstants);FEATURE_STAGING</DefineConstants>
  </PropertyGroup>
</Project>
